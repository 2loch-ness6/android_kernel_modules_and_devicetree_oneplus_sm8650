diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index abf7b41cd..47a510faf 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -736,3 +736,27 @@ CONFIG_KUNIT=y
 CONFIG_KUNIT_DEBUGFS=y
 # CONFIG_KUNIT_DEFAULT_ENABLED is not set
 # CONFIG_RUNTIME_TESTING_MENU is not set
+
+# --- C6 minimal Docker delta (kABI-safe; SYSVIPC via DroidSpaces 6_7_8 padding) ---
+CONFIG_SYSVIPC=y
+CONFIG_IPC_NS=y
+CONFIG_PID_NS=y
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
+
+# --- Nethunter BT delta (VHCI; RFCOMM/H4/BINDER already in GKI base) ---
+CONFIG_BT_HCIVHCI=m
+
+# --- C7 pass-2 REVERTED 2026-09-27 (gate red: 451 drifts via conntrack->struct net; see C8 analysis) ---
+# CONFIG_BRIDGE_NETFILTER is not set
+# CONFIG_NF_TABLES is not set
